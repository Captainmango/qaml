# Steel browser
# Default local Docker instance (bun run steel:up). To use Steel Cloud instead,
# set STEEL_BASE_URL to the cloud endpoint and provide STEEL_API_KEY.
STEEL_BASE_URL=http://localhost:3000
# Optional locally; required when STEEL_BASE_URL points at Steel Cloud.
STEEL_API_KEY=

# TypeSafe (Jev) — required. Used for Jev decision + verdict calls.
TYPESAFE_API_KEY=
# Optional override of the Jev model id.
QAML_JEV_MODEL=jev-latest

# Text helper (stage 05, TYPE_TEXT only) — small OpenAI-compatible model.
# OpenRouter works as the endpoint.
QAML_TEXT_MODEL=
QAML_TEXT_MODEL_BASE_URL=
# Provider key for the text helper (whichever provider you use).
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional override of the run artifacts directory.
QAML_RUNS_DIR=runs
