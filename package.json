{
  "name": "qaml",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run index.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "steel:up": "docker compose up -d",
    "steel:down": "docker compose down",
    "steel:logs": "docker compose logs -f api",
    "check": "biome check",
    "check:fix": "biome check --write",
    "format": "biome format",
    "format:fix": "biome format --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "browser-use": "^0.8.0",
    "steel-sdk": "^0.18.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
